<mxfile host="app.diagrams.net">
  <diagram name="BPMN Apollo Training Management">
    <mxGraphModel dx="1220" dy="720" grid="1" gridSize="10" guides="1">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Swimlanes -->
        <mxCell id="lane1" value="Học viên" style="swimlane;horizontal=0;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="250" height="600" as="geometry"/>
        </mxCell>

        <mxCell id="lane2" value="Nhân viên đào tạo" style="swimlane;horizontal=0;" vertex="1" parent="1">
          <mxGeometry x="250" y="0" width="250" height="600" as="geometry"/>
        </mxCell>

        <mxCell id="lane3" value="Giảng viên" style="swimlane;horizontal=0;" vertex="1" parent="1">
          <mxGeometry x="500" y="0" width="250" height="600" as="geometry"/>
        </mxCell>

        <mxCell id="lane4" value="Hệ thống LMS & AI" style="swimlane;horizontal=0;" vertex="1" parent="1">
          <mxGeometry x="750" y="0" width="300" height="600" as="geometry"/>
        </mxCell>

        <!-- Start -->
        <mxCell id="start" value="Bắt đầu" style="ellipse;fillColor=#8BC34A;" vertex="1" parent="lane1">
          <mxGeometry x="80" y="40" width="60" height="60" as="geometry"/>
        </mxCell>

        <!-- Student -->
        <mxCell id="register" value="Đăng ký khóa học" style="rounded=1;" vertex="1" parent="lane1">
          <mxGeometry x="40" y="140" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- Staff -->
        <mxCell id="check" value="Kiểm tra điều kiện học viên" style="rounded=1;" vertex="1" parent="lane2">
          <mxGeometry x="40" y="140" width="170" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="gateway" value="Đủ điều kiện?" style="rhombus;" vertex="1" parent="lane2">
          <mxGeometry x="70" y="220" width="100" height="60" as="geometry"/>
        </mxCell>

        <!-- System -->
        <mxCell id="ai_schedule" value="AI đề xuất lịch & phân bổ" style="rounded=1;fillColor=#E3F2FD;" vertex="1" parent="lane4">
          <mxGeometry x="40" y="300" width="220" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="approve" value="Phê duyệt lịch học" style="rounded=1;" vertex="1" parent="lane2">
          <mxGeometry x="40" y="390" width="170" height="50" as="geometry"/>
        </mxCell>

        <!-- Instructor -->
        <mxCell id="teach" value="Giảng dạy (Offline / Online)" style="rounded=1;" vertex="1" parent="lane3">
          <mxGeometry x="40" y="460" width="180" height="50" as="geometry"/>
        </mxCell>

        <!-- LMS -->
        <mxCell id="exam" value="Thi & đánh giá trên LMS" style="rounded=1;fillColor=#E3F2FD;" vertex="1" parent="lane4">
          <mxGeometry x="40" y="460" width="220" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="report" value="Theo dõi tiến độ & báo cáo (AI)" style="rounded=1;fillColor=#E3F2FD;" vertex="1" parent="lane4">
          <mxGeometry x="40" y="540" width="240" height="50" as="geometry"/>
        </mxCell>

        <!-- End -->
        <mxCell id="end" value="Kết thúc" style="ellipse;fillColor=#8BC34A;" vertex="1" parent="lane4">
          <mxGeometry x="110" y="610" width="60" height="60" as="geometry"/>
        </mxCell>

        <!-- Flows -->
        <mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="start" target="register"/>
        <mxCell id="f2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="register" target="check"/>
        <mxCell id="f3" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="check" target="gateway"/>
        <mxCell id="f4" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="gateway" target="ai_schedule"/>
        <mxCell id="f5" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="ai_schedule" target="approve"/>
        <mxCell id="f6" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="approve" target="teach"/>
        <mxCell id="f7" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="teach" target="exam"/>
        <mxCell id="f8" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="exam" target="report"/>
        <mxCell id="f9" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="report" target="end"/>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
